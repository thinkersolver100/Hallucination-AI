
# Generate with: openssl rand -hex 32
# The Express API must use the same value.
HALUDEC_SERVICE_KEY=

# Pricing configuration
HALUDEC_PRICING_FILE=pricing.json

# Select provider: groq or openrouter
HALUDEC_PROVIDER=groq

# Provider API keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Maximum request budget in USD
HALUDEC_MAX_REQUEST_BUDGET_USD=2

# Optional settings
# HALUDEC_CACHE_PATH=../runs/cache.db
# HALUDEC_EXPOSE_DOCS=1
